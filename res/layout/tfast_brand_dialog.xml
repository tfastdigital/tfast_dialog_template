<?xml version="1.0" encoding="utf-8"?>
<!-- Tfast Brand Dialog v3 — multi-app, kill switch, check update, force download -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:fadeScrollbars="false"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/tfast_dialog_bg"
        android:layout_margin="8dp">

        <View
            android:id="@+id/tfast_accent_bar"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@drawable/tfast_accent_bar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/tfast_logo_ring"
                    android:padding="4dp"
                    android:layout_marginRight="12dp">

                    <ImageView
                        android:id="@+id/tfast_logo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/tfast_logo"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/tfast_title" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tfast_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tfast_title"
                        android:textColor="@color/tfast_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:gravity="left|center_vertical" />

                    <TextView
                        android:id="@+id/tfast_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tfast_subtitle"
                        android:textColor="@color/tfast_text_secondary"
                        android:textSize="11sp"
                        android:gravity="left"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Per-app name / version / package (filled at runtime) -->
            <TextView
                android:id="@+id/tfast_app_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tfast_text_muted"
                android:textSize="10sp"
                android:gravity="center"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tfast_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/tfast_status_bg"
                android:text="@string/tfast_status_checking"
                android:textColor="@color/tfast_text_secondary"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tfast_btn_telegram"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/tfast_btn_telegram"
                    android:text="@string/tfast_btn_telegram_label"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginRight="4dp" />

                <TextView
                    android:id="@+id/tfast_btn_whatsapp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/tfast_btn_whatsapp"
                    android:text="@string/tfast_btn_whatsapp_label"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp" />

                <TextView
                    android:id="@+id/tfast_btn_tiktok"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/tfast_btn_tiktok"
                    android:text="@string/tfast_btn_tiktok_label"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginLeft="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tfast_credits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tfast_credits"
                android:textColor="@color/tfast_text_muted"
                android:textSize="10sp"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <!-- Manual re-check (always on dialog + Settings) -->
            <TextView
                android:id="@+id/tfast_btn_check_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/tfast_btn_check"
                android:text="@string/tfast_btn_check_update_label"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="6dp" />

            <!-- Force / optional download — opens update_url / apk_url -->
            <TextView
                android:id="@+id/tfast_btn_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/tfast_btn_update"
                android:text="@string/tfast_btn_update_label"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="visible"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tfast_btn_continue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/tfast_btn_continue"
                android:text="@string/tfast_btn_continue_label"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
